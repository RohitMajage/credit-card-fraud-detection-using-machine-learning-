{
  "installCommand": "npm install",
  "buildCommand": "pip install -r requirements.txt && python scripts/train_model.py && next build",
  "functions": {
    "api/index.py": {
      "runtime": "python3.9",
      "includeFiles": "api/model.joblib api/scaler.joblib"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    }
  ]
}
